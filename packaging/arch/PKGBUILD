# Maintainer: dryamovvv <https://github.com/dryamovvv/arch-mcp>
# Contributor: Nihal <2tv8xupqg@mozmail.com>

pkgname=arch-ops-server
pkgver=3.4.2
pkgrel=1
pkgdesc="MCP server bridging AI assistants with Arch Linux ecosystem (Wiki, AUR, repos, system management)"
arch=('any')
url="https://github.com/dryamovvv/arch-mcp"
license=('GPL3' 'MIT')
depends=('python>=3.11')
optdepends=(
    'btrfs-progs: BTRFS monitoring and management'
    'snapper: BTRFS snapshot management'
    'rpi-eeprom: RPi bootloader management'
    'pacman: package management (standard Arch)'
    'paru: AUR helper for package installation'
)
makedepends=('uv')
install=arch-ops-server.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/dryamovvv/arch-mcp/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/arch-mcp-$pkgver"

    _vendor="/opt/$pkgname/vendor"

    uv pip install \
        --target "$pkgdir$_vendor" \
        --python /usr/bin/python \
        .

    cat > "$pkgdir$_vendor/bin/arch-ops-server" << 'WRAPPER'
#!/bin/sh
exec /usr/bin/env PYTHONPATH=/opt/arch-ops-server/vendor \
    /usr/bin/python -c 'from arch_ops_server import main_sync; import sys; sys.exit(main_sync())'
WRAPPER
    chmod 755 "$pkgdir$_vendor/bin/arch-ops-server"

    cat > "$pkgdir$_vendor/bin/arch-ops-server-http" << 'WRAPPER'
#!/bin/sh
exec /usr/bin/env PYTHONPATH=/opt/arch-ops-server/vendor \
    /usr/bin/python -c 'from arch_ops_server import main_http_sync; import sys; sys.exit(main_http_sync())'
WRAPPER
    chmod 755 "$pkgdir$_vendor/bin/arch-ops-server-http"

    mkdir -p "$pkgdir/usr/bin"
    ln -s "$_vendor/bin/arch-ops-server" "$pkgdir/usr/bin/arch-ops-server"
    ln -s "$_vendor/bin/arch-ops-server-http" "$pkgdir/usr/bin/arch-ops-server-http"

    install -Dm644 packaging/arch/arch-ops-server.service \
        "$pkgdir/etc/systemd/system/arch-ops-server.service"
}
